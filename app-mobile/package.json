{
  "name": "ycsy-quiz",
  "version": "1.0.0",
  "description": "延长石油招聘套卷模考 · 手机 App 壳",
  "private": true,
  "scripts": {
    "sync:html": "node scripts/sync-html.js",
    "sync": "npm run sync:html && npx cap sync",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:android": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}